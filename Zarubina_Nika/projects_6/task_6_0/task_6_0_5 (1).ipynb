    "import pandas as pd\n",
    "df = pd.read_csv('wild_boars.csv')\n",
    "percentiles = [0.25, 0.50, 0.75, 0.90, 0.95, 1.00]\n",
    "result = df.select_dtypes(include=['number']).describe(percentiles=percentiles)\n",
    "result.to_csv('percentiles.csv')\n",
    "print(result)\n",
    "print(\"\\nСохранено в 'percentiles.csv'\")"
   ]
  }
